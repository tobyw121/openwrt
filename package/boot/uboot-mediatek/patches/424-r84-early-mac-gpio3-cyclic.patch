--- a/arch/mips/mach-mtmips/mt7621/Makefile
+++ b/arch/mips/mach-mtmips/mt7621/Makefile
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0
 
 obj-y += init.o
 obj-y += serial.o
+obj-$(CONFIG_R84_EARLY_MAC_GPIO3) += r84.o
 
 ifeq ($(CONFIG_SPL_BUILD),y)
--- a/arch/mips/mach-mtmips/mt7621/Kconfig
+++ b/arch/mips/mach-mtmips/mt7621/Kconfig
@@ -1,3 +1,11 @@
 if SOC_MT7621
 
+config R84_EARLY_MAC_GPIO3
+	bool "Cudy AP1300E Wall R84 early MAC and external GPIO3 watchdog"
+	depends on BOARD_MT7621_RFB
+	depends on CYCLIC
+	help
+	  Read the factory Ethernet MAC through the SPI-NOR driver
+	  BDINFO and service the external R84 GPIO3 watchdog in U-Boot.
+
 menu "CPU & DDR configuration"
--- /dev/null
+++ b/arch/mips/mach-mtmips/mt7621/r84.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Cudy AP1300E Wall R84 board-specific U-Boot runtime services.
+ * BDINFO starts at SPI-NOR offset 0xff0000.
+ * The factory MAC is stored at absolute offset 0xffde00.
+ *
+ * This is a board-specific path: do not use it for other MT7621 boards.
+ */
+#include <asm/gpio.h>
+#include <cyclic.h>
+#include <env.h>
+#include <net.h>
+#include <dm.h>
+#include <spi_flash.h>
+#include <linux/types.h>
+
+#define R84_BDINFO_MAC_OFFSET 0x00ffde00U
+#define R84_WDOG_GPIO 3
+#define R84_WDOG_HALF_PERIOD_US 1000000ULL
+
+static struct cyclic_info r84_watchdog_cyclic;
+static bool r84_watchdog_level;
+
+static void r84_watchdog_tick(struct cyclic_info *cyclic)
+{
+	r84_watchdog_level = !r84_watchdog_level;
+	gpio_set_value(R84_WDOG_GPIO, r84_watchdog_level);
+}
+
+int board_late_init(void)
+{
+	uchar mac[6];
+	struct udevice *flash_dev;
+	int ret;
+
+	/* Set ethaddr before initr_net() probes Ethernet. */
+	if (!eth_env_get_enetaddr("ethaddr", mac)) {
+		ret = spi_flash_probe_bus_cs(0, 0, &flash_dev);
+		if (ret) {
+			printf("R84: SPI-NOR probe failed (%d)\n", ret);
+		} else {
+			ret = spi_flash_read_dm(flash_dev,
+					R84_BDINFO_MAC_OFFSET,
+					sizeof(mac), mac);
+			if (ret) {
+				printf("R84: factory MAC read failed (%d)\n", ret);
+			} else if (!is_valid_ethaddr(mac)) {
+				puts("R84: invalid factory MAC\n");
+			} else {
+				ret = eth_env_set_enetaddr("ethaddr", mac);
+				if (ret)
+					printf("R84: MAC setup failed (%d)\n", ret);
+				else
+					puts("R84: factory MAC loaded from SPI NOR\n");
+			}
+		}
+	}
+
+	/* Switch the pinmux 'wdt' group to GPIO in the R84 DTS first.
+	 * cyclic callbacks execute cooperatively from U-Boot schedule().
+	 * They must remain active while the interactive console is idle.
+	 */
+	ret = gpio_request(R84_WDOG_GPIO, "r84-external-wdog");
+	if (ret) {
+		printf("R84: watchdog GPIO request failed (%d)\n", ret);
+		return 0;
+	}
+	ret = gpio_direction_output(R84_WDOG_GPIO, 0);
+	if (ret) {
+		printf("R84: watchdog GPIO output failed (%d)\n", ret);
+		gpio_free(R84_WDOG_GPIO);
+		return 0;
+	}
+	r84_watchdog_level = false;
+	cyclic_register(&r84_watchdog_cyclic, r84_watchdog_tick,
+			R84_WDOG_HALF_PERIOD_US, "r84-ext-wdog-gpio3");
+	puts("R84: GPIO3 watchdog cyclic registered\n");
+	return 0;
+}
