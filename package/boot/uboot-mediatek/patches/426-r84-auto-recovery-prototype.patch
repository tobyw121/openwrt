 r84_flash_firmware=if test "${r84_recovery_requested}" = "1"; then if test "${r84_flash_confirm}" = "YES"; then if iminfo ${loadaddr}; then if itest ${filesize} -ge 0x400000; then if itest ${filesize} -le 0xf80000; then sf probe 0:0 && sf erase 0x50000 0xf80000 && sf write ${loadaddr} 0x50000 ${filesize}; else echo ERROR - oversized image; fi; else echo ERROR - image too small; fi; else echo ERROR - invalid uImage; fi; else echo Set r84_flash_confirm to YES before flashing; fi; else echo Boot with RESET pressed before using this command; fi
+# One-button recovery: successful image structure/CRC checks BEFORE erase.
