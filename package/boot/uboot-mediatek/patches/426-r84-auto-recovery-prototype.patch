+r84_auto_recovery=echo R84 automatic TFTP recovery - 192.168.1.1 recovery.bin; if run r84_tftp_load; then if iminfo ${loadaddr}; then if r84check ${loadaddr} ${filesize}; then if sf probe 0:0; then if sf erase 0x50000 0xf80000; then if sf write ${loadaddr} 0x50000 ${filesize}; then if sf read ${r84_verify_addr} 0x50000 ${filesize}; then if cmp.b ${loadaddr} ${r84_verify_addr} ${filesize}; then echo R84 recovery verified - booting; run boot_nor; else echo ERROR FLASH VERIFY - UART recovery required; fi; else echo ERROR FLASH READ - UART recovery required; fi; else echo ERROR FLASH WRITE - UART recovery required; fi; else echo ERROR FLASH ERASE - UART recovery required; fi; else echo ERROR FLASH PROBE; fi; else echo ERROR R84 IMAGE LAYOUT; fi; else echo ERROR IMAGE CRC; fi; else echo ERROR TFTP DOWNLOAD; fi
